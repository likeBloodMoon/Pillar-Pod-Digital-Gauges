"bx_dbg_oil_pillar_lhd": {
    "information":{
        "authors":"Kristof",
        "name":"Oil Temp - A-Pillar, Any Interior (LHD)",
        "value":180,
    },
    "slotType" : "bx_dbg_oil",
    //sliders in the Tuning menu
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dbg_oil_cold", "range", "C", "Gauges", 70, 0, 100, "Oil Temp Gauge: Cold Mark Below", "A blue COLD mark shows below this oil temperature (deg C). 0 = off", {"stepDis":1}],
        ["$dbg_oil_warn", "range", "C", "Gauges", 130, 90, 160, "Oil Temp Gauge: Warning Temperature", "The digits flash at or above this oil temperature (deg C)", {"stepDis":1}],
        ["$dbg_oil_night", "range", "%", "Gauges", 12, 3, 100, "Oil Temp Gauge: Night Brightness", "Display brightness at night or with the headlights on", {"stepDis":1}],
    ],
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"dbgOilGauge"}],
    ],
    "dbgOilGauge": {
        "configuration": {
            "materialName": "@dbg_oil_screen",
            "htmlPath": "local://local/vehicles/common/pillar_pod_gauges/screen.html",
            "displayWidth":512,
            "displayHeight":512,
            "source":"oiltemp",
            "decimals":0,
            //LED arc range in deg C (the digits follow the game's temperature unit setting)
            "minValue":50,
            "maxValue":150,
            "titleLabel":"OIL TEMP",
            //digits flash at or above this temperature (deg C)
            "warnValue":"$dbg_oil_warn",
            //a blue COLD mark shows below this oil temperature (deg C); 0 = off
            "coldBelow":"$dbg_oil_cold",
            "peakHold":0,
            "nightBrightness":"$dbg_oil_night",
            "face":"black",
        },
        "displayData": {
            "electrics": [
                "oiltemp",
                "ignitionLevel",
                "lights",
                "lowhighbeam",
            ],
            "customModules": [
                ["moduleName", "property"],
                ["dbgAmbient", "light"],
                ["dbgAmbient", "maxBoost"],
            ],
        },
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //pos = centre of the gauge face. The pod mesh is shaped for exactly this spot.
