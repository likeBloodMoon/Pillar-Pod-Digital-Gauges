"bx_dbg_boost_oil_auto": {
    "information":{
        "authors":"likeBloodMoon",
        "name":"Oil Temp - Automatic Mounting",
        "value":180,
    },
    "slotType" : "bx_dbg_boost",
    //sliders in the Tuning menu
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dbg_oil_cold", "range", "C", "Gauges", 70, 0, 100, "Oil Temp Gauge: Cold Mark Below", "A blue COLD mark shows below this oil temperature (deg C). 0 = off", {"stepDis":1}],
        ["$dbg_oil_warn", "range", "C", "Gauges", 130, 90, 160, "Oil Temp Gauge: Warning Temperature", "The digits flash at or above this oil temperature (deg C)", {"stepDis":1}],
        ["$dbg_gauge_theme", "range", "colour", "Gauges", 0, 0, 5, "Gauges: Colour", "Colour of the LED ring and digits on the round gauges: 0 green with red digits, 1 white, 2 amber, 3 blue, 4 purple, 5 super green (4 and 5 also light the labels and a rim round the face). Warnings stay red", {"stepDis":1}],
        ["$dbg_gauge_night", "range", "%", "Gauges", 12, 3, 100, "Gauges: Night Brightness", "Brightness of the round gauges at night or with the headlights on", {"stepDis":1}],
        ["$dbg_shutdown_sweep", "range", "on/off", "Gauges", 1, 0, 1, "Shut-Down Sweep", "1 = the gauges sweep and the screens fade out when the ignition is switched off, 0 = they switch off at once", {"stepDis":1}],
    ],
