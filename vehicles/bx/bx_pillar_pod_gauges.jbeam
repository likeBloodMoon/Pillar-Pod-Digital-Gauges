        //meshes for every mounting (GHIJ); dbgAmbient.lua hides all but the one matching the car's interior
        ["dbgvG1pod", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
        ["dbgvG1bzk", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
        ["dbgvG1stk", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
