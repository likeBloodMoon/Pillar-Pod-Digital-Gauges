{
//Pillar Pod Digital Gauges - parts for the Ibishu 200BX.
//  Additional Modification -> Digital Pillar Gauges
//      Lower Gauge: boost (default), oil temp, coolant temp, exhaust temp, fuel level or tachometer
//      Upper Gauge: empty (default), oil temp, coolant temp, exhaust temp, fuel level, tachometer or boost
//Every gauge comes with automatic mounting, in black or silver: it picks the position that matches
//the car's interior (pillar trim, bare pillar or roll cage, left- or right-hand drive).
"bx_pillar_pod_gauges": {
    "information":{
        "authors":"likeBloodMoon",
        "name":"Digital Pillar Gauges",
        "value":0,
    },
    "slotType" : "bx_mod",
    "slots2": [
        ["name",          "allowTypes",      "denyTypes",  "default",            "description"],
        ["bx_dbg_boost",  ["bx_dbg_boost"],  [],           "bx_dbg_boost_auto",  "Lower Gauge"],
        ["bx_dbg_oil",    ["bx_dbg_oil"],    [],           "",                   "Upper Gauge"],
    ],
    //ambient light for automatic display dimming (shared by both gauges)
    "controller": [
        ["fileName"],
        ["gauges/customModules/dbgAmbient"],
    ],
},
"bx_dbg_boost_auto": {
    "information":{
        "authors":"likeBloodMoon",
        "name":"Boost - Automatic Mounting",
        "value":180,
    },
    "slotType" : "bx_dbg_boost",
    //sliders in the Tuning menu
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dbg_boost_shift", "range", "on/off", "Gauges", 1, 0, 1, "Boost Gauge: Shift Light", "1 = the LED ring flashes red near the rev limit, 0 = off", {"stepDis":1}],
        ["$dbg_boost_warn_at", "range", "psi", "Gauges", 0, 0, 45, "Boost Gauge: Overboost Warning", "The digits flash at or above this boost pressure. 0 = automatic, just above the turbo wastegate limit", {"stepDis":0.5}],
        ["$dbg_boost_recall", "range", "s", "Gauges", 2.5, 0, 6, "Boost Gauge: Peak Recall Time", "How long the peak is shown after a pull; 0 turns peak recall off", {"stepDis":0.5}],
        ["$dbg_gauge_theme", "range", "colour", "Gauges", 0, 0, 5, "Gauges: Colour", "Colour of the LED ring and digits on the round gauges: 0 green with red digits, 1 white, 2 amber, 3 blue, 4 purple, 5 super green (4 and 5 also light the labels and a rim round the face). Warnings stay red", {"stepDis":1}],
        ["$dbg_gauge_night", "range", "%", "Gauges", 12, 3, 100, "Gauges: Night Brightness", "Brightness of the round gauges at night or with the headlights on", {"stepDis":1}],
        ["$dbg_shutdown_sweep", "range", "on/off", "Gauges", 1, 0, 1, "Shut-Down Sweep", "1 = the gauges sweep and the screens fade out when the ignition is switched off, 0 = they switch off at once", {"stepDis":1}],
    ],
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"dbgGauge"}],
    ],
    "dbgGauge": {
        "configuration": {
            "materialName": "@dbg_screen",
            "htmlPath": "local://local/vehicles/common/pillar_pod_gauges/screen.html",
            "displayWidth":512,
            "displayHeight":512,
            "source":"boost",
            //"auto" follows the game's pressure unit setting; or force "psi", "bar" or "kpa"
            "unit":"auto",
            //LED arc range in PSI; LEDs below zeroValue show vacuum
            "minValue":-10,
            //0 = automatic: 1.25 x the turbo wastegate limit, so the red LEDs start just above it. A number here fixes the scale
            "maxValue":0,
            "zeroValue":0,
            //the zero mark stays on the 7th LED so it matches the printed face; the scale stretches around it
            "zeroLed":6,
            "titleLabel":"BOOST",
            //after a pull, flash the peak value for recallTime seconds
            //1 = the whole LED ring flashes red near the rev limit (shiftAt = fraction of maximum RPM)
            "shiftLight":"$dbg_boost_shift",
            "shiftAt":0.96,
            "peakRecall":true,
            "recallTime":"$dbg_boost_recall",
            //digits flash at or above this boost
            "warnValue":"$dbg_boost_warn_at",
            //seconds the peak LED stays lit
            "peakHold":1.5,
            //display brightness at night or with headlights on (1 = no dimming)
            "face":"black",
            "theme":"$dbg_gauge_theme",
            "nightBrightness":"$dbg_gauge_night",
            "shutdownSweep":"$dbg_shutdown_sweep",
        },
        "displayData": {
            "electrics": [
                "turboBoost",
                "superchargerBoost",
                "engineRunning",
                "rpm",
                "maxrpm",
                "ignitionLevel",
                "lights",
                "lowhighbeam",
            ],
            "customModules": [
                ["moduleName", "property"],
                ["dbgAmbient", "light"],
                ["dbgAmbient", "maxBoost"],
                ["dbgAmbient", "egt"],
                ["dbgAmbient", "resets"],
                ["dbgAmbient", "missing"],
            ],
        },
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //meshes for every mounting (GHIJ); dbgAmbient.lua hides all but the one matching the car's interior
        ["dbgvG1pod", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
        ["dbgvG1bzk", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
        ["dbgvG1sbk", ["bx_body"],[],{"pos":{"x":0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":27}}],
        ["dbgvH1pod", ["bx_body"],[],{"pos":{"x":0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":22.3}}],
        ["dbgvH1bzk", ["bx_body"],[],{"pos":{"x":0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":22.3}}],
        ["dbgvH1sbk", ["bx_body"],[],{"pos":{"x":0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":22.3}}],
        ["dbgvI1pod", ["bx_body"],[],{"pos":{"x":-0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":-27}}],
        ["dbgvI1bzk", ["bx_body"],[],{"pos":{"x":-0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":-27}}],
        ["dbgvI1sbk", ["bx_body"],[],{"pos":{"x":-0.6081,"y":-0.2417,"z":1.015},"rot":{"x":0,"y":0,"z":-27}}],
        ["dbgvJ1pod", ["bx_body"],[],{"pos":{"x":-0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":-22.3}}],
        ["dbgvJ1bzk", ["bx_body"],[],{"pos":{"x":-0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":-22.3}}],
        ["dbgvJ1sbk", ["bx_body"],[],{"pos":{"x":-0.5245,"y":-0.1621,"z":1.0259},"rot":{"x":0,"y":0,"z":-22.3}}],
    ],
},
