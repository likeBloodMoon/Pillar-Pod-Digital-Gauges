{
//Pillar Pod Digital Gauges - parts for the Ibishu Covet.
//  Additional Modification -> Digital Pillar Gauges
//      Boost Gauge:    automatic mounting (black or silver), or a fixed mounting
//      Oil Temp Gauge: empty, automatic mounting, or a fixed mounting
//Fit one or both. Boost sits in the lower position, oil temp above it. The automatic parts pick
//the position that matches the car's interior; the fixed ones always use the position they name.
"covet_digital_boost_gauge_pillar": {
    "information":{
        "authors":"Kristof",
        "name":"Digital Pillar Gauges",
        "value":0,
    },
    "slotType" : "covet_mod",
    "slots2": [
        ["name",             "allowTypes",         "denyTypes",  "default",               "description"],
        ["covet_dbg_boost",  ["covet_dbg_boost"],  [],           "covet_dbg_boost_auto",  "Boost Gauge"],
        ["covet_dbg_oil",    ["covet_dbg_oil"],    [],           "",                      "Oil Temp Gauge"],
    ],
    //ambient light for automatic display dimming (shared by both gauges)
    "controller": [
        ["fileName"],
        ["gauges/customModules/dbgAmbient"],
    ],
},
"covet_dbg_boost_auto": {
    "information":{
        "authors":"Kristof",
        "name":"Boost - Automatic Mounting",
        "value":180,
    },
    "slotType" : "covet_dbg_boost",
    //sliders in the Tuning menu
    "variables": [
        ["name", "type", "unit", "category", "default", "min", "max", "title", "description"],
        ["$dbg_boost_shift", "range", "", "Gauges", 1, 0, 1, "Boost Gauge: Shift Light", "1 = the LED ring flashes red near the rev limit, 0 = off", {"stepDis":1}],
        ["$dbg_boost_warn_at", "range", "psi", "Gauges", 0, 0, 45, "Boost Gauge: Overboost Warning", "The digits flash at or above this boost pressure. 0 = automatic, just above the turbo wastegate limit", {"stepDis":0.5}],
        ["$dbg_boost_recall", "range", "s", "Gauges", 2.5, 0, 6, "Boost Gauge: Peak Recall Time", "How long the peak is shown after a pull; 0 turns peak recall off", {"stepDis":0.5}],
        ["$dbg_boost_night", "range", "%", "Gauges", 12, 3, 100, "Boost Gauge: Night Brightness", "Display brightness at night or with the headlights on", {"stepDis":1}],
    ],
    "controller": [
        ["fileName"],
        ["gauges/genericGauges", {"name":"dbgGauge"}],
    ],
    "dbgGauge": {
        "configuration": {
            "materialName": "@dbg_screen",
            "htmlPath": "local://local/vehicles/common/pillar_pod_gauges/screen.html",
            "displayWidth":512,
            "displayHeight":512,
            "source":"boost",
            //"auto" follows the game's pressure unit setting; or force "psi", "bar" or "kpa"
            "unit":"auto",
            //LED arc range in PSI; LEDs below zeroValue show vacuum
            "minValue":-10,
            //0 = automatic: 1.25 x the turbo wastegate limit, so the red LEDs start just above it. A number here fixes the scale
            "maxValue":0,
            "zeroValue":0,
            //the zero mark stays on the 7th LED so it matches the printed face; the scale stretches around it
            "zeroLed":6,
            "titleLabel":"BOOST",
            //after a pull, flash the peak value for recallTime seconds
            //1 = the whole LED ring flashes red near the rev limit (shiftAt = fraction of maximum RPM)
            "shiftLight":"$dbg_boost_shift",
            "shiftAt":0.96,
            "peakRecall":true,
            "recallTime":"$dbg_boost_recall",
            //digits flash at or above this boost
            "warnValue":"$dbg_boost_warn_at",
            //seconds the peak LED stays lit
            "peakHold":1.5,
            //display brightness at night or with headlights on (1 = no dimming)
            "nightBrightness":"$dbg_boost_night",
            "face":"black",
        },
        "displayData": {
            "electrics": [
                "turboBoost",
                "superchargerBoost",
                "engineRunning",
                "rpm",
                "maxrpm",
                "ignitionLevel",
                "lights",
                "lowhighbeam",
            ],
            "customModules": [
                ["moduleName", "property"],
                ["dbgAmbient", "light"],
                ["dbgAmbient", "maxBoost"],
            ],
        },
    },
    "flexbodies": [
        ["mesh", "[group]:", "nonFlexMaterials"],
        //meshes for every mounting (ABCDEF); dbgAmbient.lua hides all but the one matching the car's interior
        ["dbgvA1pod", ["covet_dash"],[],{"pos":{"x":0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvA1bzk", ["covet_dash"],[],{"pos":{"x":0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvA1sck", ["covet_dash"],[],{"pos":{"x":0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvB1pod", ["covet_dash"],[],{"pos":{"x":0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvB1bzk", ["covet_dash"],[],{"pos":{"x":0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvB1sck", ["covet_dash"],[],{"pos":{"x":0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":24.8}}],
        ["dbgvC1pod", ["covet_dash"],[],{"pos":{"x":0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":23.8}}],
        ["dbgvC1bzk", ["covet_dash"],[],{"pos":{"x":0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":23.8}}],
        ["dbgvC1sck", ["covet_dash"],[],{"pos":{"x":0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":23.8}}],
        ["dbgvD1pod", ["covet_dash"],[],{"pos":{"x":-0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvD1bzk", ["covet_dash"],[],{"pos":{"x":-0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvD1sck", ["covet_dash"],[],{"pos":{"x":-0.5749,"y":-0.3246,"z":1.0758},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvE1pod", ["covet_dash"],[],{"pos":{"x":-0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvE1bzk", ["covet_dash"],[],{"pos":{"x":-0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvE1sck", ["covet_dash"],[],{"pos":{"x":-0.5823,"y":-0.3407,"z":1.0756},"rot":{"x":0,"y":0,"z":-24.8}}],
        ["dbgvF1pod", ["covet_dash"],[],{"pos":{"x":-0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":-23.8}}],
        ["dbgvF1bzk", ["covet_dash"],[],{"pos":{"x":-0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":-23.8}}],
        ["dbgvF1sck", ["covet_dash"],[],{"pos":{"x":-0.5175,"y":-0.2189,"z":1.0961},"rot":{"x":0,"y":0,"z":-23.8}}],
    ],
},
